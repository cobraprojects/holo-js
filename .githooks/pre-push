#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"
head=$(git rev-parse HEAD)
validate=0

while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in
    *[!0]*) ;;
    *) continue ;;
  esac
  if [ "$(git rev-parse "$local_oid^{commit}")" != "$head" ]; then
    printf '%s\n' 'Push blocked: check out the commit being pushed so validation tests that exact commit.' >&2
    exit 1
  fi
  validate=1
done

if [ "$validate" -eq 0 ]; then
  exit 0
fi

if [ -n "$(git status --porcelain)" ]; then
  printf '%s\n' 'Push blocked: commit or stash local changes so validation tests the exact commit being pushed.' >&2
  exit 1
fi

for variable in $(git rev-parse --local-env-vars); do
  unset "$variable"
done

bun run check

if [ "$(git rev-parse HEAD)" != "$head" ] || [ -n "$(git status --porcelain)" ]; then
  printf '%s\n' 'Push blocked: the checkout changed during validation. Commit or stash changes and validate again.' >&2
  exit 1
fi
