  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "svelte": "5.56.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  }
