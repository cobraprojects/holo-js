{
  "name": "@holo-js/flux-svelte",
  "version": "0.3.18",
  "description": "Holo-JS Framework - Svelte and SvelteKit Flux helper skeletons",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
