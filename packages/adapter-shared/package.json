{
  "name": "@holo-js/adapter-shared",
  "version": "0.4.3",
  "description": "Holo-JS Framework - shared framework adapter infrastructure",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobraprojects/holo-js.git",
    "directory": "packages/adapter-shared"
  },
  "exports": {
    "./realtime-directories": {
      "@holo-js/source": "./src/realtime-directories.ts",
      "types": "./dist/realtime-directories.d.ts",
      "import": "./dist/realtime-directories.mjs",
      "default": "./dist/realtime-directories.mjs"
    },
    "./server-errors": {
      "@holo-js/source": "./src/server-errors.ts",
      "types": "./dist/server-errors.d.ts",
      "import": "./dist/server-errors.mjs",
      "default": "./dist/server-errors.mjs"
    },
    ".": {
      "@holo-js/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "@holo-js/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    },
    "./build": {
      "@holo-js/source": "./src/build.ts",
      "types": "./dist/build.d.ts",
      "import": "./dist/build.mjs",
      "default": "./dist/build.mjs"
    },
    "./next/request-context": {
      "types": "./dist/next/request-context.d.ts",
      "browser": {
        "@holo-js/source": "./src/next/request-context.ts",
        "default": "./dist/next/request-context.mjs"
      },
      "edge-light": {
        "@holo-js/source": "./src/next/request-context.ts",
        "default": "./dist/next/request-context.mjs"
      },
      "node": {
        "@holo-js/source": "./src/next/request-context.node.ts",
        "default": "./dist/next/request-context.node.mjs"
      },
      "import": {
        "@holo-js/source": "./src/next/request-context.ts",
        "default": "./dist/next/request-context.mjs"
      },
      "default": {
        "@holo-js/source": "./src/next/request-context.ts",
        "default": "./dist/next/request-context.mjs"
      }
    },
    "./sveltekit/request-context": {
      "@holo-js/source": "./src/sveltekit/request-context.ts",
      "types": "./dist/sveltekit/request-context.d.ts",
      "import": "./dist/sveltekit/request-context.mjs",
      "default": "./dist/sveltekit/request-context.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@holo-js/kernel": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  }
}
