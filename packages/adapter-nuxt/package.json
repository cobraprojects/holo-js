{
  "name": "@holo-js/adapter-nuxt",
  "version": "0.3.27",
  "description": "Holo-JS Framework - Nuxt adapter",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./client": {
      "types": "./dist/runtime/composables/forms.d.ts",
      "import": "./dist/runtime/composables/forms.js"
    },
    "./runtime": {
      "types": "./dist/runtime/composables/index.d.ts",
      "import": "./dist/runtime/composables/index.js"
    },
    "./realtime": {
      "types": "./dist/runtime/composables/realtime.d.ts",
      "import": "./dist/runtime/composables/realtime.js"
    },
    "./storage": {
      "types": "./dist/runtime/composables/storage.d.ts",
      "import": "./dist/runtime/composables/storage.js"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "stub": "nuxt-module-build build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@holo-js/adapter-shared": "^0.3.27",
    "@nuxt/kit": "^4.4.4",
    "@holo-js/config": "^0.3.27",
    "@holo-js/core": "^0.3.27",
    "@holo-js/db": "^0.3.27",
    "@holo-js/validation": "^0.3.27",
    "h3": "^1.15.11",
    "nitropack": "^2.13.4"
  },
  "peerDependencies": {
    "vue": "^3.5.13",
    "@holo-js/broadcast": "^0.3.27",
    "@holo-js/forms": "^0.3.27",
    "@holo-js/realtime": "^0.3.27",
    "@holo-js/storage": "^0.3.27",
    "@holo-js/storage-s3": "^0.3.27"
  },
  "peerDependenciesMeta": {
    "@holo-js/broadcast": {
      "optional": true
    },
    "@holo-js/forms": {
      "optional": true
    },
    "@holo-js/realtime": {
      "optional": true
    },
    "@holo-js/storage": {
      "optional": true
    },
    "@holo-js/storage-s3": {
      "optional": true
    }
  },
  "devDependencies": {
    "vue": "^3.5.13",
    "@holo-js/broadcast": "^0.3.27",
    "@holo-js/realtime": "^0.3.27",
    "@holo-js/storage-s3": "^0.3.27",
    "@nuxt/module-builder": "^1.0.2",
    "@types/node": "^22.10.2",
    "nuxt": "^4.4.4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5",
    "@nuxt/nitro-server": "^4.4.4"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  }
}
