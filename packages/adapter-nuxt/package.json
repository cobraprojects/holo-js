{
  "name": "@holo-js/adapter-nuxt",
  "version": "0.4.4",
  "description": "Holo-JS Framework - Nuxt adapter",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobraprojects/holo-js.git",
    "directory": "packages/adapter-nuxt"
  },
  "exports": {
    ".": {
      "@holo-js/source": "./src/module.ts",
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./client": {
      "@holo-js/source": "./src/runtime/composables/forms.ts",
      "types": "./dist/runtime/composables/forms.d.ts",
      "import": "./dist/runtime/composables/forms.js"
    },
    "./runtime": {
      "@holo-js/source": "./src/runtime/composables/index.ts",
      "types": "./dist/runtime/composables/index.d.ts",
      "import": "./dist/runtime/composables/index.js"
    },
    "./realtime": {
      "@holo-js/source": "./src/runtime/composables/realtime.ts",
      "types": "./dist/runtime/composables/realtime.d.ts",
      "import": "./dist/runtime/composables/realtime.js"
    },
    "./storage": {
      "@holo-js/source": "./src/runtime/composables/storage.ts",
      "types": "./dist/runtime/composables/storage.d.ts",
      "import": "./dist/runtime/composables/storage.js"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "stub": "nuxt-module-build build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@holo-js/adapter-shared": "catalog:",
    "@nuxt/kit": "catalog:",
    "@holo-js/config": "catalog:",
    "@holo-js/core": "catalog:",
    "@holo-js/db": "catalog:",
    "@holo-js/kernel": "catalog:",
    "@holo-js/validation": "catalog:"
  },
  "peerDependencies": {
    "nuxt": "catalog:",
    "vue": "catalog:",
    "@holo-js/broadcast": "*",
    "@holo-js/forms": "*",
    "@holo-js/realtime": "*",
    "@holo-js/storage": "*",
    "@holo-js/storage-s3": "*"
  },
  "peerDependenciesMeta": {
    "@holo-js/broadcast": {
      "optional": true
    },
    "@holo-js/forms": {
      "optional": true
    },
    "@holo-js/realtime": {
      "optional": true
    },
    "@holo-js/storage": {
      "optional": true
    },
    "@holo-js/storage-s3": {
      "optional": true
    }
  },
  "devDependencies": {
    "vue": "catalog:",
    "@holo-js/broadcast": "catalog:",
    "@holo-js/realtime": "catalog:",
    "@holo-js/storage-s3": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@types/node": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@nuxt/nitro-server": "catalog:",
    "h3": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  }
}
