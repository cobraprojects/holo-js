{
  "name": "@holo-js/forms",
  "version": "0.5.6",
  "description": "Holo-JS Framework - forms-first validation and submission contracts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobraprojects/holo-js.git",
    "directory": "packages/forms"
  },
  "exports": {
    ".": {
      "@holo-js/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./internal/client": {
      "@holo-js/source": "./src/internal/client.ts",
      "types": "./dist/internal/client.d.ts",
      "import": "./dist/internal/client.mjs",
      "default": "./dist/internal/client.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run && node --test --test-concurrency=3 ../../tests/forms-native-browser.mjs ../../tests/forms-native-packages.mjs"
  },
  "dependencies": {
    "@holo-js/kernel": "catalog:",
    "@holo-js/validation": "catalog:"
  },
  "peerDependencies": {
    "@holo-js/security": ">=0.4.0"
  },
  "peerDependenciesMeta": {
    "@holo-js/security": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  }
}
