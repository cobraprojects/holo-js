{
  "name": "@holo-js/config",
  "version": "0.3.28",
  "description": "Holo-JS Framework - typed config loading, env layering, and runtime access",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@holo-js/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./registry": {
      "@holo-js/source": "./src/registry.ts",
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@holo-js/kernel": "catalog:",
    "jiti": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  }
}
