{
  "name": "@holo-js/db",
  "version": "0.3.28",
  "description": "Holo-JS Framework - portable database, ORM, migrations, factories, and seeders",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobraprojects/holo-js.git",
    "directory": "packages/db"
  },
  "exports": {
    ".": {
      "@holo-js/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "@holo-js/source": "./src/databaseConfig.ts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@holo-js/config": "catalog:",
    "@holo-js/kernel": "catalog:",
    "inflection": "catalog:",
    "ulid": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@holo-js/authorization": "catalog:",
    "@holo-js/db-mysql": "catalog:",
    "@holo-js/db-postgres": "catalog:",
    "@holo-js/db-sqlite": "catalog:",
    "@types/pg": "catalog:",
    "pg": "catalog:",
    "mysql2": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  }
}
