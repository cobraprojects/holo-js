{
  "name": "@holo-js/db",
  "version": "0.3.10",
  "description": "Holo-JS Framework - portable database, ORM, migrations, factories, and seeders",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@holo-js/config": "catalog:",
    "@holo-js/kernel": "catalog:",
    "inflection": "catalog:",
    "ulid": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@holo-js/db-mysql": "catalog:",
    "@holo-js/db-postgres": "catalog:",
    "@holo-js/db-sqlite": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
