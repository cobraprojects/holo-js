{
  "name": "@holo-js/auth",
  "version": "0.4.3",
  "description": "Holo-JS Framework - auth contracts, guards, and config helpers",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobraprojects/holo-js.git",
    "directory": "packages/auth"
  },
  "exports": {
    ".": {
      "@holo-js/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "@holo-js/source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./client": {
      "@holo-js/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    },
    "./next/client": {
      "@holo-js/source": "./src/next/client.ts",
      "types": "./dist/next/client.d.ts",
      "import": "./dist/next/client.mjs",
      "default": "./dist/next/client.mjs"
    },
    "./next/server": {
      "types": "./dist/next/server.d.ts",
      "browser": "./dist/next/server.edge.mjs",
      "import": {
        "@holo-js/source": "./src/next/server.ts",
        "default": "./dist/next/server.mjs"
      },
      "default": {
        "@holo-js/source": "./src/next/server.ts",
        "default": "./dist/next/server.mjs"
      }
    },
    "./sveltekit/client": {
      "@holo-js/source": "./src/sveltekit/client.ts",
      "types": "./dist/sveltekit/client.d.ts",
      "import": "./dist/sveltekit/client.mjs",
      "default": "./dist/sveltekit/client.mjs"
    },
    "./sveltekit/server": {
      "@holo-js/source": "./src/sveltekit/server.ts",
      "types": "./dist/sveltekit/server.d.ts",
      "import": "./dist/sveltekit/server.mjs",
      "default": "./dist/sveltekit/server.mjs"
    },
    "./nuxt": {
      "@holo-js/source": "./src/nuxt.ts",
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.mjs",
      "default": "./dist/nuxt.mjs"
    },
    "./nuxt/server": {
      "@holo-js/source": "./src/nuxt/server.ts",
      "types": "./dist/nuxt/server.d.ts",
      "import": "./dist/nuxt/server.mjs",
      "default": "./dist/nuxt/server.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@holo-js/kernel": "catalog:",
    "@holo-js/config": "catalog:",
    "@holo-js/validation": "catalog:",
    "@holo-js/adapter-shared": "catalog:"
  },
  "peerDependencies": {
    "@holo-js/security": "catalog:",
    "next": "catalog:",
    "nuxt": "catalog:",
    "react": "catalog:",
    "svelte": "catalog:"
  },
  "peerDependenciesMeta": {
    "@holo-js/security": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "next": "catalog:",
    "nuxt": "catalog:",
    "react": "catalog:",
    "svelte": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  }
}
