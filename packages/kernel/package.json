{
  "name": "@holo-js/kernel",
  "version": "0.3.27",
  "description": "Holo-JS Framework - dependency-free contracts, plugins, and runtime lifecycle",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@holo-js/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./http-errors": {
      "@holo-js/source": "./src/httpErrors.ts",
      "types": "./dist/http-errors.d.ts",
      "import": "./dist/http-errors.mjs",
      "default": "./dist/http-errors.mjs"
    },
    "./file-content": {
      "@holo-js/source": "./src/fileContent.ts",
      "types": "./dist/file-content.d.ts",
      "import": "./dist/file-content.mjs",
      "default": "./dist/file-content.mjs"
    },
    "./image-decoding": {
      "types": "./dist/image-decoding.d.ts",
      "browser": {
        "@holo-js/source": "./src/imageDecoding.browser.ts",
        "default": "./dist/image-decoding.browser.mjs"
      },
      "node": {
        "@holo-js/source": "./src/imageDecoding.node.ts",
        "default": "./dist/image-decoding.node.mjs"
      },
      "default": {
        "@holo-js/source": "./src/imageDecoding.ts",
        "default": "./dist/image-decoding.mjs"
      }
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "file-type": "catalog:",
    "sharp": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "peerDependencies": {
    "file-type": "catalog:",
    "sharp": "catalog:"
  },
  "peerDependenciesMeta": {
    "file-type": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  }
}
