{
  "name": "@holo-js/kernel",
  "version": "0.3.28",
  "description": "Holo-JS Framework - contracts, plugins, and runtime lifecycle",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobraprojects/holo-js.git",
    "directory": "packages/kernel"
  },
  "exports": {
    ".": {
      "@holo-js/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./error-reporting": {
      "@holo-js/source": "./src/errorReporting.ts",
      "types": "./dist/error-reporting.d.ts",
      "import": "./dist/error-reporting.mjs",
      "default": "./dist/error-reporting.mjs"
    },
    "./http-errors": {
      "@holo-js/source": "./src/httpErrors.ts",
      "types": "./dist/http-errors.d.ts",
      "import": "./dist/http-errors.mjs",
      "default": "./dist/http-errors.mjs"
    },
    "./managed-resources": {
      "@holo-js/source": "./src/managedResources.ts",
      "types": "./dist/managed-resources.d.ts",
      "import": "./dist/managed-resources.mjs",
      "default": "./dist/managed-resources.mjs"
    },
    "./file-content": {
      "@holo-js/source": "./src/fileContent.ts",
      "types": "./dist/file-content.d.ts",
      "import": "./dist/file-content.mjs",
      "default": "./dist/file-content.mjs"
    },
    "./request-body": {
      "@holo-js/source": "./src/requestBody.ts",
      "types": "./dist/request-body.d.ts",
      "import": "./dist/request-body.mjs",
      "default": "./dist/request-body.mjs"
    },
    "./image-decoding": {
      "types": "./dist/image-decoding.d.ts",
      "browser": {
        "@holo-js/source": "./src/imageDecoding.browser.ts",
        "default": "./dist/image-decoding.browser.mjs"
      },
      "node": {
        "@holo-js/source": "./src/imageDecoding.node.ts",
        "default": "./dist/image-decoding.node.mjs"
      },
      "default": {
        "@holo-js/source": "./src/imageDecoding.ts",
        "default": "./dist/image-decoding.mjs"
      }
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "file-type": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "sharp": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || ^26.0.0"
  },
  "peerDependencies": {
    "sharp": "catalog:"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  }
}
