{
  "name": "@holo-js/adapter-next",
  "version": "0.5.4",
  "description": "Holo-JS Framework - Next.js adapter",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobraprojects/holo-js.git",
    "directory": "packages/adapter-next"
  },
  "exports": {
    ".": {
      "@holo-js/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "@holo-js/source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./client": {
      "@holo-js/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    },
    "./internal/use-form": {
      "@holo-js/source": "./src/use-form.ts",
      "types": "./dist/internal/use-form.d.ts",
      "import": "./dist/internal/use-form.mjs",
      "default": "./dist/internal/use-form.mjs"
    },
    "./internal/request-validation-flash": {
      "types": "./dist/internal/request-validation-flash.d.ts",
      "edge-light": {
        "@holo-js/source": "./src/request-validation-flash.ts",
        "default": "./dist/internal/request-validation-flash.mjs"
      },
      "worker": {
        "@holo-js/source": "./src/request-validation-flash.ts",
        "default": "./dist/internal/request-validation-flash.mjs"
      },
      "browser": {
        "@holo-js/source": "./src/request-validation-flash.browser.ts",
        "default": "./dist/internal/request-validation-flash.browser.mjs"
      },
      "@holo-js/source": "./src/request-validation-flash.ts",
      "import": "./dist/internal/request-validation-flash.mjs",
      "default": "./dist/internal/request-validation-flash.mjs"
    },
    "./internal/use-validation-errors": {
      "@holo-js/source": "./src/use-validation-errors.ts",
      "types": "./dist/internal/use-validation-errors.d.ts",
      "import": "./dist/internal/use-validation-errors.mjs",
      "default": "./dist/internal/use-validation-errors.mjs"
    },
    "./realtime": {
      "@holo-js/source": "./src/realtime.ts",
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.mjs",
      "default": "./dist/realtime.mjs"
    },
    "./runtime": {
      "@holo-js/source": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "default": "./dist/runtime.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@holo-js/adapter-shared": "catalog:",
    "@holo-js/config": "catalog:",
    "@holo-js/core": "catalog:",
    "@holo-js/kernel": "catalog:",
    "@holo-js/validation": "catalog:"
  },
  "peerDependencies": {
    "@holo-js/forms": ">=0.4.0",
    "@holo-js/realtime": ">=0.4.0",
    "next": "catalog:",
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "@holo-js/forms": {
      "optional": true
    },
    "@holo-js/realtime": {
      "optional": true
    }
  },
  "devDependencies": {
    "@holo-js/realtime": "catalog:",
    "@jridgewell/trace-mapping": "catalog:",
    "@types/node": "catalog:",
    "next": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  }
}
