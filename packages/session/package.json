{
  "name": "@holo-js/session",
  "version": "0.3.27",
  "description": "Holo-JS Framework - session contracts, cookie helpers, and session config helpers",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./drivers/redis-adapter": {
      "types": "./dist/drivers/redis-adapter.d.ts",
      "import": "./dist/drivers/redis-adapter.mjs",
      "default": "./dist/drivers/redis-adapter.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@holo-js/config": "^0.3.27",
    "@holo-js/kernel": "^0.3.27"
  },
  "peerDependencies": {
    "ioredis": "^5.4.2"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ioredis": "^5.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  }
}
