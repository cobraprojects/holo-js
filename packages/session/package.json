{
  "name": "@holo-js/session",
  "version": "0.4.1",
  "description": "Holo-JS Framework - session contracts, cookie helpers, and session config helpers",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobraprojects/holo-js.git",
    "directory": "packages/session"
  },
  "exports": {
    ".": {
      "@holo-js/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "@holo-js/source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./drivers/redis-adapter": {
      "@holo-js/source": "./src/drivers/redis-adapter.ts",
      "types": "./dist/drivers/redis-adapter.d.ts",
      "import": "./dist/drivers/redis-adapter.mjs",
      "default": "./dist/drivers/redis-adapter.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run",
    "test:platform": "vitest --run tests/file-lock.test.ts tests/file-lock-contention.test.ts tests/file-lock-busy.test.ts tests/file-lock-handover.test.ts tests/file-lock-released.test.ts tests/file-lock-young-release.test.ts --pool forks --maxWorkers 1 --reporter=json"
  },
  "dependencies": {
    "@holo-js/config": "catalog:",
    "@holo-js/kernel": "catalog:"
  },
  "peerDependencies": {
    "ioredis": "catalog:"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "ioredis": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  }
}
