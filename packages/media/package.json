{
  "name": "@holo-js/media",
  "version": "0.3.27",
  "description": "Holo-JS Framework - media collections and conversions for Holo-JS models",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/projectConfig.d.ts",
      "import": "./dist/projectConfig.mjs",
      "default": "./dist/projectConfig.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@holo-js/config": "^0.3.27",
    "@holo-js/db": "^0.3.27",
    "@holo-js/queue": "^0.3.27",
    "@holo-js/storage": "^0.3.27",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@holo-js/db-sqlite": "^0.3.27",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  }
}
