{
  "name": "@holo-js/media",
  "version": "0.3.15",
  "description": "Holo-JS Framework - media collections and conversions for Holo-JS models",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/projectConfig.d.ts",
      "import": "./dist/projectConfig.mjs",
      "default": "./dist/projectConfig.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@holo-js/config": "catalog:",
    "@holo-js/db": "catalog:",
    "@holo-js/queue": "catalog:",
    "@holo-js/storage": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@holo-js/db-sqlite": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  }
}
