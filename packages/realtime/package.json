{
  "name": "@holo-js/realtime",
  "version": "0.5.1",
  "description": "Holo-JS Framework - realtime query and mutation runtime",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobraprojects/holo-js.git",
    "directory": "packages/realtime"
  },
  "exports": {
    ".": {
      "@holo-js/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "@holo-js/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    },
    "./server": {
      "@holo-js/source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json --noEmit",
    "test": "vitest --run",
    "benchmark": "HOLO_REALTIME_BENCHMARK=1 vitest --run tests/realtime.benchmark.test.ts --testTimeout 0 --silent=false"
  },
  "dependencies": {
    "@holo-js/broadcast": "workspace:*",
    "@holo-js/db": "catalog:",
    "@holo-js/kernel": "catalog:",
    "@holo-js/validation": "catalog:",
    "esbuild": "catalog:"
  },
  "peerDependencies": {
    "@holo-js/auth": ">=0.4.0",
    "@holo-js/security": ">=0.4.0"
  },
  "peerDependenciesMeta": {
    "@holo-js/auth": {
      "optional": true
    },
    "@holo-js/security": {
      "optional": true
    }
  },
  "devDependencies": {
    "@holo-js/auth": "catalog:",
    "@holo-js/security": "catalog:",
    "@holo-js/db-sqlite": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  }
}
