{
  "name": "@holo-js/realtime",
  "version": "0.3.27",
  "description": "Holo-JS Framework - realtime query and mutation runtime",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@holo-js/broadcast": "^0.3.27",
    "@holo-js/db": "^0.3.27",
    "@holo-js/validation": "^0.3.27",
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "@holo-js/auth": "^0.3.27",
    "@holo-js/security": "^0.3.27"
  },
  "peerDependenciesMeta": {
    "@holo-js/auth": {
      "optional": true
    },
    "@holo-js/security": {
      "optional": true
    }
  },
  "devDependencies": {
    "@holo-js/auth": "^0.3.27",
    "@holo-js/security": "^0.3.27",
    "@holo-js/db-sqlite": "^0.3.27",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  }
}
