{
  "name": "@holo-js/validation",
  "version": "0.3.28",
  "description": "Holo-JS Framework - schema contracts, typing, and validation surface",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@holo-js/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./internal/compiled": {
      "@holo-js/source": "./src/internal/compiled.ts",
      "types": "./dist/internal/compiled.d.ts",
      "import": "./dist/internal/compiled.mjs",
      "default": "./dist/internal/compiled.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@holo-js/kernel": "catalog:",
    "file-type": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || ^26.0.0"
  }
}
