{
  "name": "@holo-js/cli",
  "version": "0.4.3",
  "description": "Holo-JS Framework - project creation, discovery, and operational CLI",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobraprojects/holo-js.git",
    "directory": "packages/cli"
  },
  "bin": {
    "holo": "./dist/bin/holo.mjs",
    "holo-js": "./dist/bin/holo.mjs"
  },
  "exports": {
    ".": {
      "@holo-js/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "node ../../scripts/generate-cli-workspace-catalog.mjs && tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run && HOLO_CLI_INCLUDE_INTEGRATION=1 vitest --run tests/cli.test.ts",
    "test:integration": "HOLO_CLI_INCLUDE_INTEGRATION=1 vitest --run tests/cli.test.ts",
    "test:platform": "node ../../node_modules/vitest/vitest.mjs --run tests/native-broadcast-installation.test.ts tests/native-package-managers.test.ts --pool forks --fileParallelism --maxWorkers 4 --reporter=json"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@holo-js/auth": "catalog:",
    "@holo-js/cache-db": "catalog:",
    "@holo-js/config": "catalog:",
    "@holo-js/core": "catalog:",
    "@holo-js/db": "catalog:",
    "@holo-js/kernel": "catalog:",
    "@holo-js/security": "catalog:",
    "@holo-js/storage": "catalog:",
    "esbuild": "catalog:",
    "inflection": "catalog:",
    "minimatch": "catalog:",
    "semver": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "@holo-js/broadcast": "catalog:",
    "@holo-js/mail": "catalog:",
    "@holo-js/media": "catalog:",
    "@holo-js/session": "catalog:",
    "@holo-js/queue": "catalog:",
    "@holo-js/schedule": "catalog:"
  },
  "peerDependenciesMeta": {
    "@holo-js/broadcast": {
      "optional": true
    },
    "@holo-js/mail": {
      "optional": true
    },
    "@holo-js/media": {
      "optional": true
    },
    "@holo-js/queue": {
      "optional": true
    },
    "@holo-js/schedule": {
      "optional": true
    },
    "@holo-js/session": {
      "optional": true
    }
  },
  "devDependencies": {
    "@holo-js/adapter-sveltekit": "catalog:",
    "@holo-js/broadcast": "catalog:",
    "@holo-js/events": "catalog:",
    "@holo-js/mail": "catalog:",
    "@holo-js/media": "catalog:",
    "@holo-js/queue": "catalog:",
    "@holo-js/queue-db": "catalog:",
    "@holo-js/session": "catalog:",
    "@sveltejs/adapter-node": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "tsup": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@holo-js/schedule": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  }
}
