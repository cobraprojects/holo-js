{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@holo-js/cache-db": [
        "../cache-db/src/index.ts"
      ],
      "@holo-js/config": [
        "../config/src/index.ts"
      ],
      "@holo-js/db": [
        "../db/src/index.ts"
      ],
      "@holo-js/events": [
        "../events/src/index.ts"
      ],
      "@holo-js/queue": [
        "../queue/src/index.ts"
      ],
      "@holo-js/queue-redis": [
        "../queue/src/queue-redis.d.ts"
      ],
      "@holo-js/queue-db": [
        "../queue-db/src/index.ts"
      ],
      "@holo-js/security": [
        "../security/src/index.ts"
      ],
      "@holo-js/session/drivers/redis-adapter": [
        "../session/src/drivers/redis-adapter.ts"
      ],
      "@holo-js/storage": [
        "../storage/src/index.ts"
      ],
      "@holo-js/kernel": [
        "../kernel/src/index.ts"
      ],
      "@holo-js/notifications": [
        "../notifications/src/index.ts"
      ],
      "@holo-js/cache": [
        "../cache/src/index.ts"
      ],
      "@holo-js/session": [
        "../session/src/index.ts"
      ],
      "@holo-js/auth": [
        "../auth/src/index.ts"
      ],
      "@holo-js/broadcast": [
        "../broadcast/src/index.ts"
      ],
      "@holo-js/mail": [
        "../mail/src/index.ts"
      ],
      "@holo-js/media": [
        "../media/src/index.ts"
      ],
      "@holo-js/media/config": [
        "../media/src/projectConfig.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
