{
  "name": "@holo-js/broadcast",
  "version": "0.3.27",
  "description": "Holo-JS Framework - broadcast contracts, channel definitions, and driver registration seams",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.mjs",
      "default": "./dist/auth.mjs"
    },
    "./client-config": {
      "types": "./dist/client-config.d.ts",
      "import": "./dist/client-config.mjs",
      "default": "./dist/client-config.mjs"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.mjs",
      "default": "./dist/contracts.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "default": "./dist/runtime.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@holo-js/config": "^0.3.27",
    "@holo-js/kernel": "^0.3.27",
    "@holo-js/queue": "^0.3.27",
    "@holo-js/validation": "^0.3.27",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@holo-js/db": "^0.3.27",
    "ioredis": "^5.4.2"
  },
  "peerDependenciesMeta": {
    "@holo-js/db": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@holo-js/db": "^0.3.27",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "ioredis": "^5.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  }
}
