{
  "name": "@holo-js/broadcast",
  "version": "0.4.2",
  "description": "Holo-JS Framework - broadcast contracts, channel definitions, and driver registration seams",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobraprojects/holo-js.git",
    "directory": "packages/broadcast"
  },
  "exports": {
    ".": {
      "@holo-js/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "@holo-js/source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./auth": {
      "@holo-js/source": "./src/auth.ts",
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.mjs",
      "default": "./dist/auth.mjs"
    },
    "./client-config": {
      "@holo-js/source": "./src/client-config.ts",
      "types": "./dist/client-config.d.ts",
      "import": "./dist/client-config.mjs",
      "default": "./dist/client-config.mjs"
    },
    "./contracts": {
      "@holo-js/source": "./src/contracts.ts",
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.mjs",
      "default": "./dist/contracts.mjs"
    },
    "./runtime": {
      "@holo-js/source": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "default": "./dist/runtime.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@holo-js/config": "catalog:",
    "@holo-js/kernel": "catalog:",
    "@holo-js/queue": "catalog:",
    "@holo-js/validation": "catalog:",
    "ws": "catalog:"
  },
  "peerDependencies": {
    "@holo-js/db": "catalog:",
    "ioredis": "catalog:"
  },
  "peerDependenciesMeta": {
    "@holo-js/db": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@holo-js/db": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "ioredis": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  }
}
