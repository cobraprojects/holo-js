{
  "name": "@holo-js/broadcast",
  "version": "0.3.3",
  "description": "Holo-JS Framework - broadcast contracts, channel definitions, and driver registration seams",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.mjs",
      "default": "./dist/auth.mjs"
    },
    "./client-config": {
      "types": "./dist/client-config.d.ts",
      "import": "./dist/client-config.mjs",
      "default": "./dist/client-config.mjs"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.mjs",
      "default": "./dist/contracts.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "default": "./dist/runtime.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "stub": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@holo-js/config": "catalog:",
    "@holo-js/kernel": "catalog:",
    "@holo-js/queue": "catalog:",
    "@holo-js/validation": "catalog:",
    "ws": "catalog:"
  },
  "peerDependencies": {
    "ioredis": "catalog:"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "ioredis": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
