{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "server/**/*.ts",
    "config/**/*.ts",
    ".holo-js/generated/**/*.ts",
    ".holo-js/generated/**/*.d.ts",
    "vite.config.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "src/service-worker"
  ]
}
